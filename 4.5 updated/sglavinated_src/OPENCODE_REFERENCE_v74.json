   "char": "JESUS",
   "line1": "NON DORMI PIU?",
   "line2": "COMANDA LEI"
  },
  {
   "id": 107,
   "char": "JESUS",
   "line1": "IL VIOLA FERMA",
   "line2": "IL RESPIRO"
  },
  {
   "id": 108,
   "char": "JESUS",
   "line1": "SCIROPPO E ALCOL",
   "line2": "TI FERMANO"
  },
  {
   "id": 109,
   "char": "JESUS",
   "line1": "ALCUNI RAPPER",
   "line2": "DEL DRANK: MORTI"
  },
  {
   "id": 110,
   "char": "JESUS",
   "line1": "BASTA, CAZZO.",
   "line2": "CHIAMA IL SERT"
  },
  {
   "id": 111,
   "char": "JESUS",
   "line1": "NON TI SALVO IO,",
   "line2": "TI SALVI TU"
  },
  {
   "id": 112,
   "char": "JESUS",
   "line1": "LA ROBA TI USA,",
   "line2": "NON IL CONTRARIO"
  },
  {
   "id": 113,
   "char": "JESUS",
   "line1": "PARLANE, FRA:",
   "line2": "NON SEI SOLO"
  },
  {
   "id": 114,
   "char": "JESUS",
   "line1": "CHIEDERE AIUTO",
   "line2": "NON E' DEBOLEZZA"
  },
  {
   "id": 115,
   "char": "JESUS",
   "line1": "SERT, MEDICO,",
   "line2": "AMICO: PARLANE"
  },
  {
   "id": 116,
   "char": "JESUS",
   "line1": "AL SESTO PIANO",
   "line2": "NESSUNO TI SALVA"
  },
  {
   "id": 117,
   "char": "JESUS",
   "line1": "CHI TI VENDE",
   "line2": "NON TI AIUTA"
  },
  {
   "id": 118,
   "char": "JESUS",
   "line1": "COSTA POCO, POI",
   "line2": "TI PRENDE TUTTO"
  },
  {
   "id": 119,
   "char": "JESUS",
   "line1": "SCALINO DOPO",
   "line2": "SCALINO, GIU"
  },
  {
   "id": 120,
   "char": "JESUS",
   "line1": "ASCIUGHERO'",
   "line2": "OGNI TUA LACRIMA"
  },
  {
   "id": 121,
   "char": "GIANNI",
   "line1": "ERBA A BORDO?",
   "line2": "LA MIA E' MEGLIO"
  },
  {
   "id": 122,
   "char": "GIANNI",
   "line1": "SEI NEL PRATO,",
   "line2": "COME ME, FRA"
  },
  {
   "id": 123,
   "char": "GIANNI",
   "line1": "SULL'ERBA VAI",
   "line2": "PIU' LEGGERO"
  },
  {
   "id": 124,
   "char": "GIANNI",
   "line1": "PERSO LA STRADA?",
   "line2": "TE LA RULLO IO"
  },
  {
   "id": 125,
   "char": "JESUS",
   "line1": "NON TI FIDARE!",
   "line2": "TI VUOLE FREGARE"
  },
  {
   "id": 126,
   "char": "JESUS",
   "line1": "ANCHE IO AVEVO",
   "line2": "PROVATO: NO."
  },
  {
   "id": 127,
   "char": "JESUS",
   "line1": "MEGLIO LEGGERE",
   "line2": "IL TESTO, FRA"
  },
  {
   "id": 128,
   "char": "JESUS",
   "line1": "NON INIETTARTI",
   "line2": "IN VENA!"
  },
  {
   "id": 129,
   "char": "JESUS",
   "line1": "CERCA DI NON",
   "line2": "FARTI DI EROINA"
  },
  {
   "id": 130,
   "char": "JESUS",
   "line1": "CHIAMA DON",
   "line2": "LURIDO: TI AIUTA"
  },
  {
   "id": 131,
   "char": "JESUS",
   "line1": "AMA CHI VUOI,",
   "line2": "NON LA ROBA"
  },
  {
   "id": 132,
   "char": "JESUS",
   "line1": "ORGOGLIO VERO:",
   "line2": "VIVERE LUCIDI"
  },
  {
   "id": 133,
   "char": "JESUS",
   "line1": "ARCOBALENO SI,",
   "line2": "SIRINGHE NO"
  },
  {
   "id": 134,
   "char": "GIANNI",
   "line1": "FUORI STRADA?",
   "line2": "UN TIRO E RIENTRI"
  },
  {
   "id": 135,
   "char": "GIANNI",
   "line1": "SULLA SABBIA?",
   "line2": "TI SERVE GIANNI"
  },
  {
   "id": 136,
   "char": "GIANNI",
   "line1": "BORDO STRADA:",
   "line2": "COME LA TUA VITA"
  },
  {
   "id": 137,
   "char": "GIANNI",
   "line1": "DI SPINELLI",
   "line2": "NESSUNO MUORE"
  },
  {
   "id": 138,
   "char": "GIANNI",
   "line1": "HEY ANDIAMO A",
   "line2": "FARCI UNO"
  },
  {
   "id": 139,
   "char": "GIANNI",
   "line1": "CI FACCIAMO UNA",
   "line2": "DIERA?"
  },
  {
   "id": 140,
   "char": "GIANNI",
   "line1": "E' SOLO UNO",
   "line2": "SPINELLINO"
  },
  {
   "id": 141,
   "char": "JESUS",
   "line1": "TI VEDO",
   "line2": "DALL'ALTO"
  },
  {
   "id": 142,
   "char": "GIANNI",
   "line1": "BORDO? RILASSATI",
   "line2": "FATTI UNA DIERA"
  },
  {
   "id": 143,
   "char": "GIANNI",
   "line1": "NEI CAMPI, FRA",
   "line2": "CRESCO IO, FRA"
  },
  {
   "id": 144,
   "char": "GIANNI",
   "line1": "SBANDI? TRANQUI,",
   "line2": "SEI GIA' IN VOLO"
  },
  {
   "id": 145,
   "char": "GIANNI",
   "line1": "SBANDATA BELLA!",
   "line2": "UN ALTRO GIRO?"
  },
  {
   "id": 146,
   "char": "GIANNI",
   "line1": "RUOTE NEL VERDE:",
   "line2": "CASA MIA, BRO"
  },
  {
   "id": 147,
   "char": "JESUS",
   "line1": "LA MARIA NON",
   "line2": "TI SALVA, FRA"
  },
  {
   "id": 148,
   "char": "JESUS",
   "line1": "CARCIOFO O K:",
   "line2": "E' SOLO FUMO"
  },
  {
   "id": 149,
   "char": "JESUS",
   "line1": "APOCALIPSE:",
   "line2": "IL DRAGO E' QUI"
  },
  {
   "id": 150,
