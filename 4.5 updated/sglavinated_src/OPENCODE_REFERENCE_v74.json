 "VAR_offsets_from_0xFF8F00": {
  "24": "Gianni pose/art loaded flag (xtab guard: Jesus-only if 0)",
  "28": "crash pending (set with 60)",
  "46": "pose load progress; gcheck only when >=8",
  "52": "show loading in progress (crash waits)",
  "60": "crash request",
  "68": "distance/progress guard (>=256)",
  "70": "race guard (>=1)",
  "84": "retry counter",
  "120": "off-road cooldown (>=60)",
  "122": "Jesus-mode flag for phrase select (ctab)",
  "150/152": "PAL line-wrap tracking",
  "174": "show frames left",
  "176": "start line for room()",
  "178": "rotating phrase counter (incremented at ss_go)"
 },
 "game_RAM": {
  "0xFFF05A": "off-road/edge bits (&0xF0)",
  "0xFFF03E": "speed (ph_ns: >=250 -> fast-phrase set)",
  "0xFFF169": "stage number (1-based)",
  "0xFFF10C": "race timer guard (>=400 to allow shows)",
  "0xFFF000": "main state"
 },
 "characters": {
  "GIANNI": {
   "role": "tempter (cannabis leaf)",
   "trigger": "off-road / edge touch: F05A&0xF0 for >=8 frames, cooldown VAR120>=60 -> phrase from otab; random periodic shows use ph_tab",
   "art": "shots/g_frames.bin static 8 poses x 4 pieces (4x4 tiles), pose change every 16 frames, sway sw_tab, gmask skips identical pieces",
   "exit": "slides out with xo_tab over last 24 frames; bubble hidden when <30 frames left"
  },
  "JESUS": {
   "role": "corrector",
   "trigger": "any crash/rollover: VAR60=1,VAR28=1 -> pe_n2 -> phrase from xtab. Crash always wins; if Gianni showing, he is cut with his exit; if a show is loading (VAR52) it waits",
   "exit": "rises in last 60 frames; bubble hidden when <55 frames left"
  },
  "UFO": {
   "role": "random flyby, no phrase",
   "code": "label apps; tables ufw/ufo_off/ufs"
  }
 },
 "show_timing": {
  "length_frames": "220 + 30*stage",
  "periodic_interval_by_stage(pr_tab)": [
   500,
   440,
   400,
   360,
   320
  ],
  "cpu_budget": "PBUDGET=58 lines per VBlank (room())"
 },
 "phrase_selection": {
  "otab": "off-road Gianni phrases",
  "xtab": "crash Jesus phrases",
  "ph_tab": "periodic Gianni pool, 4 groups x 32 (indexed by stage)",
  "jtab": "periodic Jesus pool",
  "ctab": "Jesus-mode pool (VAR122!=0)",
  "ph_ns": "speed>=250 -> phrase 55 or 22..24",
  "ph_b1/ph_b2": "arithmetic fallback ranges (divu 25 -> 44..65/85.., divu 19)"
 },
