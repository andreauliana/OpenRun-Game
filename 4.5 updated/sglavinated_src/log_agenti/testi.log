import json
d=json.load(open('motore_nuovo/dati/frasi.json',encoding='utf-8'))
acc=set('àèéìíîòóùúÀÈÉÌÍÎÒÓÙÚ')
viol=[]
ids={}
for f in d['frasi']:
    i=f['id']; p=f['personaggio']; l1=f['linea1']; l2=f['linea2']
    ids[i]=p
    if l1!=l1.upper() or l2!=l2.upper(): viol.append((i,'maiuscole'))
    if len(l1)>16 or len(l2)>16: viol.append((i,'lunghezza',len(l1),len(l2)))
    if any(c in acc for c in l1+l2): viol.append((i,'accenti'))
    if l1=='' or l2=='' or len([l for l in (l1,l2) if l!=''])>2: viol.append((i,'righe'))
g=set(d['range_personaggio_v87']['gianni']); s=set(d['range_personaggio_v87']['gesu'])
for i,p in ids.items():
    want='gianni' if i in g else ('gesu' if i in s else None)
    if want is None: viol.append((i,'id fuori range'))
    elif p!=want: viol.append((i,'coerenza personaggio',p,want))
tab=set()
for k,v in d['tabelle_show_v87'].items():
    if isinstance(v,list):
        for x in v: tab.add(x)
    elif isinstance(v,dict):
        for kk,vv in v.items():
            if isinstance(vv,list):
                for x in vv: tab.add(x)
for x in tab:
    if x not in ids: viol.append((x,'tabella id inesistente'))
print('totale frasi:', d['totale'], '| id_min:', d['id_min'], '| id_max:', d['id_max'])
print('gianni:', len(g), 'gesu:', len(s), 'union:', len(g|s), 'inter:', len(g&s))
print('violazioni:', len(viol))
for v in viol[:40]: print(' -', v)
print('max len riga1:', max(len(f['linea1']) for f in d['frasi']), 'max len riga2:', max(len(f['linea2']) for f in d['frasi']))
print('--- TABELLA COMPLETA (id, personaggio, riga1, riga2) ---')
print('| id | personaggio | riga1 | riga2 |')
print('|---|---|---|---|')
for f in d['frasi']:
    print('| %d | %s | %s | %s |' % (f['id'], f['personaggio'], f['linea1'], f['linea2']))
