import json

fixes_frasi = {
    3: {"linea1": "TI PORTO L'ANIMA"},
    6: {"linea1": "FIRMA IL PATTO,"},
    8: {"linea2": "UN FIGLIO A META"},
    15: {"linea2": "TE L'HO PRESA"},
    17: {"linea2": "IL PATTO E FATTO"},
    20: {"linea1": "FUOCO TI ASPETTA"},
    50: {"linea1": "HO ROBA PIU"},
    56: {"linea2": "SAPRA MAI"},
    63: {"linea2": "SI FERMA PIU"},
    74: {"linea2": "IL PASSO E BREVE"},
    81: {"linea2": "DARO ACQUA VIVA"},
    120: {"linea1": "ASCIUGHERO"},
    123: {"linea2": "PIU LEGGERO"},
    134: {"linea2": "UN TIRO, RIENTRI"},
    144: {"linea2": "SEI GIA IN VOLO"},
    150: {"linea2": "NON MORRA MAI"},
}
fixes_gianni = {k: v for k, v in fixes_frasi.items() if k in {3,6,8,15,17,20,50,56,63,123,134,144}}
fixes_gesu = {k: v for k, v in fixes_frasi.items() if k in {74,81,120,150}}

note_frasi = ("I testi sono della hack v87 (sola lettura); nel nuovo motore sono dati sostituibili. "
 "I limiti hardware della v87 (156 fumetti, budget Mega Drive) NON si portano. "
 "Revisione BLOCCO G (turno 1 @testi): tutte le 156 frasi verificate per le regole del nuovo motore "
 "(maiuscole, max 2 righe, riga <= 16 caratteri, no accenti, no contenuto sessuale); "
 "16 righe corrette in 15 id, vedi motore_nuovo/dati/testi/REVISIONE_FRASI.md.")

regole_nuovo = {
    "maiuscole": True,
    "max_righe": 2,
    "max_caratteri_riga": 16,
    "no_accenti": True,
    "no_contenuto_sessuale": False,
    "limite_numero_frasi": False
}

jobs = [
    ("motore_nuovo/dati/frasi.json", fixes_frasi, True),
    ("motore_nuovo/dati/personaggi/gianni/fumetti.json", fixes_gianni, False),
    ("motore_nuovo/dati/personaggi/gesu/fumetti.json", fixes_gesu, False),
]

for path, fixes, is_frasi in jobs:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    frasi = data.get("frasi", data)
    by_id = {fr["id"]: fr for fr in frasi}
    n = 0
    for id_, campi in fixes.items():
        if id_ not in by_id:
            print("MANCANTE", path, id_); continue
        fr = by_id[id_]
        for campo, nuovo in campi.items():
            vecchio = fr[campo]
            if vecchio != nuovo:
                fr[campo] = nuovo
                n += 1
                print(path, id_, campo, vecchia if False else vecchio, "->", nuovo)
    if is_frasi:
        data["versione"] = 2
        data["note"] = note_frasi
        items = list(data.items())
        new_items = []
        for k, v in items:
            new_items.append((k, v))
            if k == "regole_testo_v87":
                new_items.append(("regole_testo_nuovo", regole_nuovo))
        data.clear()
        data.update(new_items)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    print(path, "righe modificate:", n)
print("FATTO")
EOF
